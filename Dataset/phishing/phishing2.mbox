    <TD vAlign=baseline align=left colSpan=9 height=10><FONT 
      face="Verdana, Arial, Helvetica, sans-serif"><strong>Traveling the Customer Loyalty Highway <img src="http://www.optimusltd.com/images/highway7.jpg" width="30" height="29"></strong></FONT></TD>
    <TD vAlign=bottom align=middle width=230 height=10>
      <DIV align=center><FONT color=#98b342 size=2><STRONG><FONT 
